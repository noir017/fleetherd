{
  "name": "talkcode",
  "version": "2.46.1",
  "license": "MIT",
  "comments": {
    "pinnedDeps": "@satorijs/adapter-slack and @satorijs/core are pinned to exact versions: the Slack profile relies on their undocumented internal behavior (see the header comment in src/platform/profiles/slack.ts). Before upgrading either, you must manually regress Slack button/slash reception—no CI covers this path.",
    "jsdom": "Held at ^27 by CI's Node version, not by taste. jsdom 28+ nests an undici that calls webidl.util.markAsUncloneable, which Node 20 does not have, so npm ci installs happily and then every test in page.dom.test.ts dies at import. jsdom's own engines field says so, but nothing enforces it. Raising this pin means raising node-version in ci.yml and the >=20 engines below together."
  },
  "description": "Your coding agent in every chat app: a gateway daemon connecting Telegram, Discord, Slack, Lark and more, or its own web UI, to Claude Code, Codex, OpenCode or Antigravity",
  "type": "module",
  "bin": {
    "talkcode": "./dist/cli.js"
  },
  "files": [
    "dist",
    "skill",
    "skill-super"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build-remote.mjs",
    "test:remote": "node scripts/build-remote.mjs --check",
    "dev": "tsx src/cli.ts",
    "dev:watch": "tsx watch src/cli.ts start",
    "stop": "node scripts/stop.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "start": "node dist/cli.js start",
    "release": "node scripts/release.mjs",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "^0.81.0",
    "@agentclientprotocol/sdk": "0.29.0",
    "@cordisjs/plugin-http": "^0.6.0",
    "@inquirer/prompts": "^7.0.0",
    "@koishijs/plugin-adapter-discord": "^4.0.0",
    "@satorijs/adapter-dingtalk": "^2.5.1",
    "@satorijs/adapter-lark": "^3.12.6",
    "@satorijs/adapter-line": "^2.5.0",
    "@satorijs/adapter-qq": "^4.13.0",
    "@satorijs/adapter-slack": "2.5.0",
    "@satorijs/adapter-telegram": "^4.5.11",
    "@satorijs/adapter-wecom": "^2.5.0",
    "@satorijs/core": "4.6.0",
    "@toon-format/toon": "^2.3.0",
    "commander": "^12.0.0",
    "croner": "^10.0.1",
    "https-proxy-agent": "^7.0.6",
    "picocolors": "^1.1.0",
    "undici": "^6.27.0",
    "yaml": "^2.5.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/jsdom": "^27.0.0",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.39.4",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^27.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.62.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noir017/talkcode.git"
  },
  "homepage": "https://github.com/noir017/talkcode#readme",
  "bugs": {
    "url": "https://github.com/noir017/talkcode/issues"
  },
  "keywords": [
    "claude-code",
    "acp",
    "agent",
    "telegram",
    "discord",
    "slack",
    "feishu",
    "lark",
    "qq",
    "line",
    "wecom",
    "chatbot",
    "gateway",
    "koishi",
    "satori"
  ]
}
